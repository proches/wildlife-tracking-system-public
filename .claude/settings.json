{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/venv/bin/python\" \"$CLAUDE_PROJECT_DIR/tools/git_autosync.py\" --reason claude-session",
            "timeout": 900,
            "async": true,
            "statusMessage": "Pushing changes to GitHub"
          }
        ]
      }
    ]
  }
}
